{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "15",
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TURBO_TELEMETRY_DISABLED",
    "ENVIRONMENT",
    "INKEEP_AGENTS_MANAGE_DATABASE_URL",
    "INKEEP_AGENTS_RUN_DATABASE_URL",
    "INKEEP_AGENTS_API_URL",
    "PUBLIC_INKEEP_AGENTS_API_URL",
    "NEXT_PUBLIC_INKEEP_AGENTS_API_URL",
    "INKEEP_AGENTS_MANAGE_UI_URL",
    "PORT",
    "AGENTS_API_PORT",
    "MANAGE_UI_PORT",
    "LOG_LEVEL",
    "SPICEDB_ENDPOINT",
    "SPICEDB_PRESHARED_KEY",
    "SPICEDB_TLS_ENABLED",
    "SMTP_HOST",
    "SMTP_PORT"
  ],
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "sync:licenses": {
      "cache": false,
      "inputs": ["LICENSE.md", "SUPPLEMENTAL_TERMS.md", "scripts/sync-licenses.mjs"],
      "outputs": [
        "packages/*/LICENSE.md",
        "packages/*/SUPPLEMENTAL_TERMS.md",
        "agents-*/LICENSE.md",
        "agents-*/SUPPLEMENTAL_TERMS.md"
      ]
    },
    "build": {
      "dependsOn": ["^build", "sync:licenses"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        ".env.example"
      ],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "prepack": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.{test,spec}.{js,jsx,ts,tsx}"],
      "env": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY"],
      "passThroughEnv": ["PW_TEST_CONNECT_WS_ENDPOINT", "INKEEP_PRIVATE_MONOREPO"],
      "outputs": ["coverage/**"]
    },
    // Visual regression suite. Separate task rather than chained into `test`
    // so the canonical `pnpm test` stays runnable without the Dockerised
    // Playwright server (see public/agents/AGENTS.md). It keeps `test`'s
    // `dependsOn: build` edge because agents-manage-ui's *.browser.test.tsx
    // import `@inkeep/agents-core/client-exports`, which resolves only to
    // `dist/` — running this against an unbuilt workspace fails module
    // resolution rather than skipping. `cache: false` because the suite's
    // real dependency is the external Playwright server, which turbo cannot
    // hash; a cache hit would report green without exercising it.
    //
    // `inputs` is NOT inert under `cache: false`: turbo hashes every task in the
    // graph whether or not it stores outputs, so this bounds the file scan and
    // scopes `turbo watch`. What it does NOT do is gate whether the task RUNS —
    // the CI step's `--filter` does that.
    "test:visual": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.browser.test.tsx", "src/__screenshots__/**"],
      "passThroughEnv": ["PW_TEST_CONNECT_WS_ENDPOINT", "INKEEP_PRIVATE_MONOREPO"],
      "cache": false
    },
    "@inkeep/agents-mcp#build": {
      "dependsOn": ["^build", "sync:licenses"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        ".env.example"
      ],
      "outputs": ["esm/**", "bin/**", ".tsbuildinfo"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "**/*.{test,spec}.{js,jsx,ts,tsx}"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lint:fix": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false
    },
    "knip": {},
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "typecheck:watch": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "dependsOn": ["db:manage:generate", "db:run:generate"],
      "cache": false
    },
    "db:migrate": {
      "dependsOn": ["db:manage:migrate", "db:run:migrate"],
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:clean": {
      "cache": false
    },
    "db:check": {
      "dependsOn": ["db:manage:check", "db:run:check"],
      "cache": false
    },
    "db:manage:generate": {
      "cache": false,
      "inputs": ["drizzle.manage.config.ts", "src/db/manage/manage-schema.ts"],
      "outputs": ["drizzle/manage/**"]
    },
    "db:manage:migrate": {
      "cache": false,
      "inputs": ["drizzle/manage/**", "src/db/manage/manage-schema.ts"]
    },
    "db:manage:drop": {
      "cache": false
    },
    "db:manage:studio": {
      "cache": false,
      "persistent": true
    },
    "db:manage:check": {
      "cache": false,
      "inputs": ["drizzle.manage.config.ts", "src/db/manage/manage-schema.ts"]
    },
    "db:run:generate": {
      "cache": false,
      "inputs": ["drizzle.run.config.ts", "src/db/runtime/runtime-schema.ts"],
      "outputs": ["drizzle/runtime/**"]
    },
    "db:run:migrate": {
      "cache": false,
      "inputs": ["drizzle/runtime/**", "src/db/runtime/runtime-schema.ts"]
    },
    "db:run:drop": {
      "cache": false
    },
    "db:run:studio": {
      "cache": false,
      "persistent": true
    },
    "db:run:check": {
      "cache": false,
      "inputs": ["drizzle.run.config.ts", "src/db/runtime/runtime-schema.ts"]
    },
    "docs#dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["lint", "typecheck", "test"],
      "cache": false
    },
    "check:husky": {
      "dependsOn": ["build", "lint", "typecheck", "test"],
      "cache": false,
      "outputs": []
    },
    "check:prepush": {
      "dependsOn": ["lint", "typecheck", "test"],
      "cache": false,
      "outputs": []
    }
  }
}
